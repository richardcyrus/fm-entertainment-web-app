{
  "name": "fm-entertainment-web-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richardcyrus/fm-entertainment-web-app.git"
  },
  "keywords": [],
  "author": "Richard Cyrus <richard.cyrus@rcyrus.com> (https://www.richardcyrus.com)",
  "bugs": {
    "url": "https://github.com/richardcyrus/fm-entertainment-web-app/issues"
  },
  "homepage": "https://github.com/richardcyrus/fm-entertainment-web-app#readme",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "fix": "concurrently pnpm:fix:*",
    "fix:code": "eslint  --fix \"**/*.[tj]s?(x)\"",
    "fix:css": "stylelint \"**/*.css\" --cache --cache-location ./node_modules/.cache/stylelint --fix",
    "lint": "concurrently pnpm:lint:*",
    "lint:code": "eslint \"**/*.[tj]s?(x)\"",
    "lint:css": "stylelint './**/*.css' --fix --cache --cache-location ./node_modules/.cache/stylelint",
    "format": "prettier --write './**/*.{css,js,jsx,ts,tsx,json.md}'",
    "postinstall": "prisma generate",
    "prepare": "husky install",
    "test": "vitest run",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed": "dotenv -e .env.local -- prisma db seed"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-pacer": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "dotenv": "^17.4.2",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swiper": "^14.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.167.34",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "micromatch": "^4.0.8",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.0",
    "vitest-axe": "1.0.0-pre.5"
  },
  "volta": {
    "node": "24.20.0"
  }
}
